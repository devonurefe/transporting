generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Machine {
  id                      String        @id
  name                    String
  category                String
  categoryLabel           String
  height                  Float
  reach                   Float
  weight                  Float
  pricePerDay             Float
  oneDayPrice             Float?
  powerType               String
  imageUrl                String
  imageAlt                String
  description             String
  suitableFor             Json
  weeklyDiscountPercent   Float?
  monthlyDiscountPercent  Float?
  campaignText            String?
  campaignDiscountPercent Float?
  campaignDiscountAmount  Float?
  weekendPrice            Float?
  twoDayPrice             Float?
  weeklyPrice             Float?
  monthlyPrice            Float?
  packageContents         String?
  additionalImages        Json?
  specs                   Json?
  bufferDays              Int           @default(0)
  isActive                Boolean       @default(true)
  blockedDates            BlockedDate[]
  updatedAt               DateTime      @updatedAt @default(now())

  @@index([category])
  @@index([pricePerDay])
}

model Category {
  id          String @id
  label       String
  listLabel   String
  desc        String
  heights     String
  price       String
  infoContent Json?
}

model BlockedDate {
  id        String  @id @default(uuid())
  machineId String
  date      DateTime
  reason    String
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, date])
}

model Customer {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String
  name              String
  phone             String?
  profile           String?
  companyName       String?
  address           String?
  avatarUrl         String?
  isEmailVerified      Boolean   @default(false)
  verificationToken    String?
  verificationExpiry   DateTime?
  passwordResetToken   String?
  passwordResetExpiry  DateTime?
  createdAt            DateTime  @default(now())
  orders               Order[]
}

model Admin {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                String    @default("admin")
  createdAt           DateTime  @default(now())
  passwordResetToken  String?
  passwordResetExpiry DateTime?
}

model InvoiceCounter {
  id         String @id @default("default")
  lastNumber Int    @default(0)
}

model Order {
  id              String    @id
  machineId       String
  machineName     String
  machinePrice    Float
  startDate       DateTime
  endDate         DateTime
  rentalDays      Int
  deliveryType      String
  deliveryAddress   String?
  deliveryTimeSlot  String?
  customerName      String
  customerEmail   String
  customerPhone   String?
  customerProfile String?
  subtotal        Float
  transportCost   Float
  driverCost      Float
  vatAmount       Float
  totalAmount     Float
  status          String
  createdAt       DateTime  @default(now())
  customerId      String?
  addons          String
  invoiceNumber   String?   @unique
  paymentStatus   String    @default("awaiting")

  customer        Customer? @relation(fields: [customerId], references: [id])

  @@index([machineId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([machineId, startDate, endDate, status])
}

model OrderRating {
  id        String   @id @default(uuid())
  orderId   String   @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model SiteConfig {
  id               String @id @default("default")
  siteName         String
  heroTagline      String
  heroTitle        String
  heroSubtitle     String
  menuHomeLabel    String
  menuCatalogLabel  String
  menuAdvisorLabel  String?
  menuOrdersLabel   String
  menuAdminLabel   String
  campaignRules    Json?
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
}
