generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Machine {
  id                      String        @id
  name                    String
  category                String
  categoryLabel           String
  height                  Float
  reach                   Float
  weight                  Float
  pricePerDay             Float
  oneDayPrice             Float?
  powerType               String
  imageUrl                String
  imageAlt                String
  description             String
  suitableFor             Json
  weeklyDiscountPercent   Float?
  monthlyDiscountPercent  Float?
  campaignText            String?
  campaignDiscountPercent Float?
  campaignDiscountAmount  Float?
  weekendPrice            Float?
  twoDayPrice             Float?
  threeDayPrice           Float?
  fourDayPrice            Float?
  weeklyPrice             Float?
  extraDayPrice           Float?
  monthlyPrice            Float?
  sundayBlockFee          Float?
  weekendRulesEnabled     Boolean       @default(false)
  packageContents         String?
  additionalImages        Json?
  specs                   Json?
  bufferDays              Int           @default(0)
  minRentalDays           Int?
  weeklyOnly              Boolean       @default(false)
  pickupOnly              Boolean       @default(false)
  stockQuantity           Int           @default(1)
  crossSellAddons         Json?
  isActive                Boolean       @default(true)
  showInWeeklyOffers       Boolean       @default(false)
  deletedAt               DateTime?
  blockedDates            BlockedDate[]
  updatedAt               DateTime      @updatedAt @default(now())

  @@index([category])
  @@index([pricePerDay])
  @@index([deletedAt])
}

model Category {
  id          String @id
  label       String
  listLabel   String
  desc        String
  heights     String
  price       String
  infoContent Json?
}

model BlockedDate {
  id        String  @id @default(uuid())
  machineId String
  date      DateTime
  reason    String
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, date])
}

model Customer {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String
  name              String
  phone             String?
  profile           String?
  companyName       String?
  address           String?
  avatarUrl         String?
  isEmailVerified      Boolean   @default(false)
  verificationToken    String?
  verificationExpiry   DateTime?
  passwordResetToken   String?
  passwordResetExpiry  DateTime?
  marketingConsent     Boolean   @default(false)
  emailOptIn           Boolean   @default(true)
  createdAt            DateTime  @default(now())
  orders               Order[]
}

model Admin {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                String    @default("admin")
  createdAt           DateTime  @default(now())
  passwordResetToken  String?
  passwordResetExpiry DateTime?
}

model InvoiceCounter {
  id         String @id @default("default")
  lastNumber Int    @default(0)
}

model Order {
  id              String    @id
  machineId       String
  machineName     String
  machinePrice    Float
  startDate       DateTime
  endDate         DateTime
  rentalDays      Int
  deliveryType      String
  deliveryAddress   String?
  deliveryTimeSlot  String?
  customerName      String
  customerEmail   String
  customerPhone   String?
  customerProfile String?
  subtotal        Float
  transportCost   Float
  driverCost      Float
  vatAmount       Float
  totalAmount     Float
  status          String
  createdAt       DateTime  @default(now())
  customerId      String?
  addons          String
  weekendWork     String?
  invoiceNumber   String?   @unique
  paymentStatus   String    @default("awaiting")

  customer        Customer? @relation(fields: [customerId], references: [id])

  @@index([machineId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([machineId, startDate, endDate, status])
}

model OrderRating {
  id        String   @id @default(uuid())
  orderId   String   @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model SiteConfig {
  id               String @id @default("default")
  siteName         String
  heroTagline      String
  heroTitle        String
  heroSubtitle     String
  heroImageUrl     String?
  menuHomeLabel    String
  menuCatalogLabel  String
  menuAdvisorLabel  String? // legacy/unused column — kept to avoid a destructive db push on deploy
  menuOrdersLabel   String
  menuAdminLabel   String
  campaignRules    Json?
  contactEmail     String?
  contactPhone     String?
  companyAddress   String?
  kvkNumber        String?
  btwNumber        String?
  companyLegalName String?
  // Real external Google Business rating — entered by an admin (Customizer) and
  // shown in the footer's "Google Reviews" block. Never invent a value: when
  // unset the footer shows no score.
  googleRating      Float?
  googleReviewCount Int?
  // Admin-curated echte Google-reviews voor de footer-ticker. Array van
  // { author, rating, text, date }. De eigenaar plaatst hier echte reviews van
  // het Google-bedrijfsprofiel; niets verzonnen.
  googleReviews     Json?
  // Adviestool (product-finder) admin overrides: { enabled, waFallback, overrides }.
  // Question STRUCTURE + matching logic stay in code (src/utils/advisor.ts); only
  // copy, the on/off toggle and the WhatsApp fallback text are stored here.
  advisorConfig     Json?
}

// UNUSED: no code reads or writes this table. Kept (not dropped) to avoid a
// destructive `prisma db push` on deploy — same policy as SiteConfig.menuAdvisorLabel.
// Admin activity is currently tracked via the client-side system log (AdminLogs),
// and customer email preferences via Customer.emailOptIn — neither uses this model.
// If a persisted in-app notification feature is ever built, wire it here.
model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
}
