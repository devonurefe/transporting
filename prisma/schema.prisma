generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Machine {
  id                      String        @id
  name                    String
  category                String
  categoryLabel           String
  height                  Float
  reach                   Float
  weight                  Float
  pricePerDay             Float
  oneDayPrice             Float?
  powerType               String
  imageUrl                String
  imageAlt                String
  description             String
  suitableFor             Json
  weeklyDiscountPercent   Float?
  monthlyDiscountPercent  Float?
  campaignText            String?
  campaignDiscountPercent Float?
  campaignDiscountAmount  Float?
  weekendPrice            Float?
  twoDayPrice             Float?
  threeDayPrice           Float?
  fourDayPrice            Float?
  weeklyPrice             Float?
  extraDayPrice           Float?
  monthlyPrice            Float?
  sundayBlockFee          Float?
  weekendRulesEnabled     Boolean       @default(false)
  packageContents         String?
  additionalImages        Json?
  specs                   Json?
  // Admin-uploaded technical datasheet PDF (e.g. manufacturer spec sheet), stored
  // as a base64 data:application/pdf URL — same pattern as imageUrl. Never exposed
  // raw on the public /api/machines feed; served via /machine-datasheet/:id (see
  // toPublicMachine in server/routes/machines.ts and the proxy in server.ts).
  datasheetUrl             String?
  bufferDays              Int           @default(0)
  minRentalDays           Int?
  weeklyOnly              Boolean       @default(false)
  pickupOnly              Boolean       @default(false)
  stockQuantity           Int           @default(1)
  crossSellAddons         Json?
  isActive                Boolean       @default(true)
  showInWeeklyOffers       Boolean       @default(false)
  deletedAt               DateTime?
  // Permanent "out of fleet" flag — set only by an admin, distinct from
  // isActive (catalog visibility) and from the temporary damage/maintenance
  // blocks below (DamageReport/MaintenanceEvent). A retired machine is never
  // bookable, regardless of isActive.
  isRetired                Boolean       @default(false)
  blockedDates            BlockedDate[]
  updatedAt               DateTime      @updatedAt @default(now())

  @@index([category])
  @@index([pricePerDay])
  @@index([deletedAt])
}

model Category {
  id          String @id
  label       String
  listLabel   String
  desc        String
  heights     String
  price       String
  infoContent Json?
}

model BlockedDate {
  id        String  @id @default(uuid())
  machineId String
  date      DateTime
  reason    String
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, date])
}

model Customer {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String
  name              String
  phone             String?
  profile           String?
  companyName       String?
  address           String?
  avatarUrl         String?
  isEmailVerified      Boolean   @default(false)
  verificationToken    String?
  verificationExpiry   DateTime?
  passwordResetToken   String?
  passwordResetExpiry  DateTime?
  marketingConsent     Boolean   @default(false)
  emailOptIn           Boolean   @default(true)
  tokenVersion         Int       @default(0)
  failedLoginCount     Int       @default(0)
  lockedUntil          DateTime?
  createdAt            DateTime  @default(now())
  orders               Order[]
}

model Admin {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                String    @default("admin")
  createdAt           DateTime  @default(now())
  passwordResetToken  String?   // sha256-hex van het gemailde token, nooit plaintext
  passwordResetExpiry DateTime?
  isActive            Boolean   @default(true)
  tokenVersion        Int       @default(0)
  failedLoginCount    Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  totpSecret          String?   // AES-256-GCM versleuteld (zie server/utils/crypto.ts)
  twoFactorEnabled    Boolean   @default(false)
}

model InvoiceCounter {
  id         String @id @default("default")
  lastNumber Int    @default(0)
}

model Order {
  id              String    @id
  machineId       String
  machineName     String
  machinePrice    Float
  startDate       DateTime
  endDate         DateTime
  rentalDays      Int
  deliveryType      String
  deliveryAddress   String?
  deliveryTimeSlot  String?
  // Aantal dagen dat de klant de aanhanger houdt (bij deliveryType "trailer_rental").
  // Null voor niet-trailer bezorgtypes en voor legacy-orders van vóór deze functie —
  // de transportkosten worden dan berekend als trailerPerDay × volledige huurperiode.
  trailerDays       Int?
  customerName      String
  customerEmail   String
  customerPhone   String?
  customerProfile String?
  // Optionele inkoopordernummer (PO) van de klant — puur ter referentie op de
  // factuur. Vrije tekst, gesanitiseerd/gecapped in orders.ts.
  poNumber        String?
  subtotal        Float
  transportCost   Float
  driverCost      Float
  vatAmount       Float
  totalAmount     Float
  status          String
  createdAt       DateTime  @default(now())
  customerId      String?
  addons          String
  weekendWork     String?
  invoiceNumber   String?   @unique
  paymentStatus   String    @default("awaiting")
  // Door de klant gekozen betaalwijze bij het afrekenen: "link" (online iDEAL/Tikkie-
  // betaallink) of "on_location" (betalen bij ophalen/levering). Null voor legacy-orders
  // van vóór deze keuze — de admin-UI behandelt null als "link".
  paymentMethod   String?
  // Mollie payment-link ID (pl_...), aangemaakt vlak na het plaatsen van een "link"-order.
  //
  // Dit veld IS de koppeling waarop de webhook een binnengekomen betaling matcht:
  // server/routes/webhooks.ts zoekt de order op via `molliePaymentId === <id uit de
  // webhook-body>`. Empirisch vastgesteld: bij een Payment Links-flow post Mollie
  // het id van de LINK zelf (pl_...) — precies wat hier is opgeslagen — en niet het
  // id van de onderliggende betaling (tr_...). Het description-veld wordt alleen op
  // Mollie's eigen dashboard getoond en nooit voor matching gebruikt.
  //
  // Wijzig deze matching niet zonder webhooks.ts erbij te lezen: een eerdere versie
  // ging uit van een tr_...-id en riep payments.get() aan met een pl_...-id, wat
  // Mollie's SDK weigert — daardoor werd er nooit een order gevonden en bleef elke
  // betaling op "awaiting" staan.
  molliePaymentId   String?
  // De echte, klantklare betaal-URL die Mollie teruggeeft — vervangt de handmatige
  // "[PLAK HIER DE BETAALLINK]" placeholder in het WhatsApp-sjabloon van de admin.
  mollieCheckoutUrl String?
  paymentReminderSentAt DateTime?
  // Door de admin voorgestelde herplan-datums (WhatsApp-datumvoorstel). Beide null
  // = geen openstaand voorstel. Puur ter opvolging in het adminpaneel; de echte
  // huurperiode (startDate/endDate) wijzigt pas als de admin de order daadwerkelijk
  // aanpast nadat de klant akkoord is.
  proposedStartDate DateTime?
  proposedEndDate   DateTime?
  proposedAt        DateTime?
  // Set once an "overdue rental" alert email has been sent for this order
  // (status "Onderweg" past its endDate) — prevents re-sending the same
  // alert on every daily cron run. Cleared implicitly once status moves on.
  overdueAlertSentAt DateTime?

  customer        Customer? @relation(fields: [customerId], references: [id])

  @@index([machineId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([machineId, startDate, endDate, status])
}

model OrderRating {
  id        String   @id @default(uuid())
  orderId   String   @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

// Damage reported on a machine — logged via POST /api/orders/:id/report-damage
// (order-linked, the common case) or directly via the Maintenance admin panel
// (no order — e.g. damage noticed outside a rental). While resolvedAt is null
// the machine is operationally blocked (see server/utils/machineStatus.ts) —
// it cannot be booked regardless of stockQuantity/availability elsewhere.
model DamageReport {
  id          String    @id @default(uuid())
  orderId     String?
  machineId   String
  machineName String
  description String
  // Array of base64 data: URLs — admin-only, never exposed on any public
  // endpoint (same discipline as the audit-log rule against base64 in meta).
  photos      Json?
  repairCost  Float?
  reportedAt  DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([machineId])
}

// Structured maintenance record, replacing the free-text BlockedDate.reason
// workaround. While completedDate is null the machine is operationally
// blocked (same mechanism as DamageReport) — reactive, not predictive: an
// admin opens this when maintenance actually starts, not in advance.
model MaintenanceEvent {
  id            String    @id @default(uuid())
  machineId     String
  machineName   String
  description   String
  cost          Float?
  scheduledDate DateTime  @default(now())
  completedDate DateTime?

  @@index([machineId])
}

// Kenniscentrum content: SEO blog articles ("artikel") and shareable product
// guides / how-it-works ("handleiding"). Admin-managed via AdminBlog; the public
// /kenniscentrum pages and the server-side Article JSON-LD read from this table.
// Only published=true rows are shown publicly or listed in the sitemap.
model BlogPost {
  id        String   @id
  slug      String   @unique
  type      String   @default("artikel") // "artikel" | "handleiding"
  title     String
  excerpt   String
  category  String
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([published])
  @@index([type])
}

model SiteConfig {
  id               String @id @default("default")
  siteName         String
  heroTagline      String
  heroTitle        String
  heroSubtitle     String
  heroImageUrl     String?
  menuHomeLabel    String
  menuCatalogLabel  String
  menuAdvisorLabel  String? // legacy/unused column — kept to avoid a destructive db push on deploy
  menuOrdersLabel   String
  menuAdminLabel   String
  campaignRules    Json?
  contactEmail     String?
  contactPhone     String?
  // WhatsApp-bedrijfsnummer (alleen cijfers, bv. "31611691692") dat de
  // WhatsApp-deeplinks op de site aandrijft. null = val terug op de
  // VITE_WHATSAPP_NUMBER env-var (historisch gedrag). Los van contactPhone,
  // dat een net leesbaar weergavenummer is (met spaties/+).
  whatsappNumber   String?
  companyAddress   String?
  kvkNumber        String?
  btwNumber        String?
  companyLegalName String?
  // Real external Google Business rating — entered by an admin (Customizer) and
  // shown in the footer's "Google Reviews" block. Never invent a value: when
  // unset the footer shows no score.
  googleRating      Float?
  googleReviewCount Int?
  // Admin-curated echte Google-reviews voor de footer-ticker. Array van
  // { author, rating, text, date }. De eigenaar plaatst hier echte reviews van
  // het Google-bedrijfsprofiel; niets verzonnen.
  googleReviews     Json?
  // Adviestool (product-finder) admin overrides: { enabled, waFallback, overrides }.
  // Question STRUCTURE + matching logic stay in code (src/utils/advisor.ts); only
  // copy, the on/off toggle and the WhatsApp fallback text are stored here.
  advisorConfig     Json?
  // Coffee Corner: admin-editable homepage block (image + copy + optional CTA)
  // shown just above the footer. Off by default until an admin fills it in and
  // enables it — mirrors the heroImageUrl base64-storage pattern.
  coffeeCornerEnabled     Boolean?
  coffeeCornerTitle       String?
  coffeeCornerDescription String?
  coffeeCornerImageUrl    String?
  coffeeCornerCtaLabel    String?
  coffeeCornerCtaHref     String?
  // Photo gallery: admin-editable homepage carousel (real company/work photos)
  // shown between Coffee Corner and the footer reviews. Off by default until an
  // admin fills in a title + at least one photo — same "no fabricated content"
  // rule as Coffee Corner. Images stored as base64 (same pattern as
  // heroImageUrl/coffeeCornerImageUrl), served via /site-gallery-image/:idx so
  // the public site-config payload stays small.
  galleryEnabled          Boolean?
  galleryTitle            String?
  galleryDescription      String?
  galleryImages           Json?
  // Admin-beheerbare content (AdminContent-paneel). Alle velden nullable:
  // null = gebruik de hard-coded fallback in de code (single source of defaults;
  // seed hoeft nooit aangepast). Gesanitized in server/routes/siteConfig.ts.
  faqItems          Json?   // [{ q, a }] max 40, q≤200, a≤2000
  uspItems          Json?   // [{ icon, title, text }] max 8, icon uit whitelist
  openingHours      Json?   // { monFri, sat, sun } strings ≤60
  transportFees     Json?   // { deliveryFee, trailerPerDay } — zie prijs-spiegel in orders.ts
  globalAddons      Json?   // { safety: {name, pricePerWeek}, rijplaten: {name, pricePerWeek} }
  footerDescription String?
  seoTitle          String?
  seoDescription    String?
  // Juridische pagina's (markdown, ≤60k). NOOIT in de publieke /api/site-config
  // response (payload-grootte) — geserveerd via GET /api/pages/:slug.
  privacyPolicy     String?
  termsConditions   String?
}

// Server-side audit trail van beveiligings- en beheeracties (login, orderstatus,
// machine-CRUD, site-config, ...). Geschreven via server/utils/audit.ts
// (fire-and-forget), gelezen door GET /api/admin/audit-logs (AdminLogs-paneel).
// Rijen ouder dan 180 dagen worden dagelijks opgeruimd (pruneAuditLogs).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  actorRole  String   // "admin" | "customer" | "anonymous" | "system"
  action     String   // dot-namespaced: "login.success", "order.status", ...
  entity     String?  // "Order" | "Machine" | "SiteConfig" | "Admin" | ...
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

// UNUSED: no code reads or writes this table. Kept (not dropped) to avoid a
// destructive `prisma db push` on deploy — same policy as SiteConfig.menuAdvisorLabel.
// Admin activity is currently tracked via the client-side system log (AdminLogs),
// and customer email preferences via Customer.emailOptIn — neither uses this model.
// If a persisted in-app notification feature is ever built, wire it here.
model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
}
