# JWT_SECRET: Required in production. Use a long, random value.
JWT_SECRET="replace-with-a-long-random-secret"

# DATABASE_URL: Prisma database connection string (PostgreSQL only).
# Local development (docker compose up postgres):
DATABASE_URL="postgresql://huurgo:huurgo_dev_pass@localhost:5432/huurgo"
# Bound the connection pool so a traffic spike can't exhaust Postgres connections
# ("too many connections"). Prisma reads these from the URL query string:
# DATABASE_URL="postgresql://user:password@host:5432/huurgo?schema=public&connection_limit=10&pool_timeout=20"

# ADMIN_DEFAULT_PASSWORD: Password for the seeded admin account.
# If not set, a random password will be generated and printed to console during seeding.
ADMIN_DEFAULT_PASSWORD=""

# Email delivery via Resend. Leave empty locally to use mock email logging.
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"
ADMIN_EMAIL="info@huurgo.nl"

# APP_URL: Production base URL — used in e-maillinks and canonical URLs.
APP_URL="https://huurgo.nl"

# WhatsApp (Optional)
VITE_WHATSAPP_NUMBER="31612345678"

# Microsoft Clarity analytics (Optional). Leave empty to disable tracking.
# NOTE (KVKK/GDPR): only enable once a cookie-consent banner is in place for EU visitors.
VITE_CLARITY_ID=""

# Calendar subscribe feed (Optional). A long random secret that gates the read-only
# iCal feed at /api/calendar/<token>/huurgo.ics (blocked dates + bookings). Leave
# empty to keep the feature disabled. The admin Calendar panel shows the full
# subscribe URL when this is set.
CALENDAR_FEED_TOKEN=""

# Mollie payment links (Optional). test_... key while developing/verifying, swap
# for a live_... key once the Mollie business account is verified — no code
# change needed for that swap. Leave empty to fall back to the fully-manual
# placeholder-link flow (server/services/mollieService.ts).
MOLLIE_API_KEY=""

