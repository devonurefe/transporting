# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Required in production. Use a long, random value.
JWT_SECRET="replace-with-a-long-random-secret"

# DATABASE_URL: Prisma database connection string.
# For local SQLite development:
DATABASE_URL="file:./dev.db"
# For production PostgreSQL (example):
# DATABASE_URL="postgresql://user:password@host:5432/hoogwerkerhub?schema=public"

# ADMIN_DEFAULT_PASSWORD: Password for the seeded admin account.
# If not set, a random password will be generated and printed to console during seeding.
ADMIN_DEFAULT_PASSWORD=""

# Email delivery via Resend. Leave empty locally to use mock email logging.
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"
ADMIN_EMAIL="info@hoogwerkerhub.nl"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
